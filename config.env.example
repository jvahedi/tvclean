# Copy to config.env and fill in. config.env is gitignored.

# adb serial (ip:port). Leave empty to use the only connected device.
# Wireless debugging picks a new port after reboots; `./tv.sh connect` finds it.
ADB_SERIAL=

# Tier 1 DNS. e.g. abc123.dns.nextdns.io  or  dns.adguard-dns.com
PRIVATE_DNS_HOST=
